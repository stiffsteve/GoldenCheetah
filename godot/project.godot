; Engine configuration file.
; Godot second client, step 3: minimal project. Runs the
; Phase 5 dashboard workout through the GcTrainSession
; GDExtension node. Headless proof: godot --headless --path .
; The editor binary is Godot 4.5.1; godot-cpp is 4.5-stable.

config_version=5

[application]

config/name="GoldenCheetah Train Client"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
